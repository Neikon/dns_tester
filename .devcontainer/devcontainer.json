// Dev container for DNS Tester targeting Fedora 44 to mirror the expected runtime.
{
  "name": "DNS Tester (Fedora 44)",
  "image": "registry.fedoraproject.org/fedora:44",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached,Z",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerUser": "root",
  "remoteUser": "root",
  "updateRemoteUserUID": false,
  // Install system dependencies required for GTK/libadwaita Python development with Meson.
  // Use array form to avoid Zed's double `sh -c` quoting bug with `&&` (string form becomes `sh -c "/bin/sh -c dnf ..."` → Missing command).
  "postCreateCommand": [
    "dnf",
    "-y",
    "install",
    "--refresh",
    "git",
    "bash-completion",
    "python3",
    "python3-pip",
    "python3-setuptools",
    "python3-wheel",
    "python3-gobject",
    "meson",
    "ninja-build",
    "pkg-config",
    "gcc",
    "gcc-c++",
    "make",
    "fish",
    "gobject-introspection-devel",
    "gtk4-devel",
    "libadwaita-devel",
    "glib2-devel",
    "cairo-devel",
    "pango-devel",
    "desktop-file-utils",
    "appstream",
    "dbus-daemon",
    "which",
    "findutils"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "python.defaultInterpreterPath": "/usr/bin/python3"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-vscode.cpptools"
      ]
    }
  }
}
